# Local-only development values. Do not use these defaults in staging or production.
KEYCLOAK_DB_PASSWORD=replace-local-only
KEYCLOAK_STOREFRONT_CLIENT_SECRET=replace-local-only
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-local-only
PUBLIC_HOSTS=localhost;127.0.0.1
TRUSTED_PROXY_IPS=
# Cloudinary stays unset for local builds and tests.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
